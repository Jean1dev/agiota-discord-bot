BOT_TOKEN=
MONGO_URL=mongodb://localhost:27017/bot
NODE_ENV=dev
# Discord User IDs dos administradores, separados por vírgula (imutáveis — não usar username)
# Para encontrar: Discord → Configurações → Avançado → Modo desenvolvedor → botão direito no perfil → Copiar ID
ADMIN_DISCORD_USER_IDS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost
ASSISTANT_ID=
ASSISTANT_IAM_APIKEY=
SENTRY_DNS=
GITHUB_API_TOKEN=
CAIXINHA_KEY=
AMQP_CONNECTION=amqp://adm:123456@localhost:5672/virtualhost
# URL base do serviço de comunicação (SMS/e-mail); opcional — há default no código
COMMUNICATION_SERVER_URL=
CAIXINHA_SERVER_URL=
# URL base do serviço de compras de mercado (endpoint /reports/:month); opcional — há default no código
COMPRAS_MERCADO_API_URL=
# URL de callback enviada ao serviço merchant-receipt-analysis para notificar o andamento do job do cupom
RECEIPT_WEBHOOK_URL=
# LiteLLM gateway (obrigatório para chat / STT / TTS / features de IA)
# Ex.: https://lite-llm-deploy-production.up.railway.app  (o bot acrescenta /v1 se faltar)
LITELLM_BASE_URL=
LITELLM_API_KEY=
FINANCE_API_AUTH=
TELEGRAM_API_KEY=
ADMIN_KEYCLOACK_USERNAME=
ADMIN_KEYCLOACK_PASSWORD=
ADMIN_KEYCLOACK_CLIENT_ID=
CLOUD_CONVERT_API=
CRYPTO_SERVICE_DB=
# Default interno: 450 MB (471859200 bytes)
CRYPTO_DB_STORAGE_LIMIT_BYTES=
# API oficial Organizze (leitura de categorias/transacoes). Sem username/password as operacoes falham.
ORGANIZZE_API_BASE_URL=https://api.organizze.com.br/rest/v2
ORGANIZZE_BASIC_USERNAME=
ORGANIZZE_BASIC_PASSWORD=
ORGANIZZE_USER_AGENT=
